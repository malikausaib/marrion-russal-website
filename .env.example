# ==============================================================================
# MARRION RUSSAL REMEDIES PVT. LTD. — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure the necessary parameters for production.
# NEVER commit sensitive API secrets or passwords into version control.

# Server Port
PORT=3000
HOST=0.0.0.0
DEBUG=False

# Admin Authentication Secret Key (Generate a random 64-character hex string)
ADMIN_SECRET_KEY=mrr_secret_key_change_in_production_2026

# Database Path
DATABASE_PATH=marrion_russal.db

# ==============================================================================
# PAYMENT GATEWAY: RAZORPAY (India PCI-DSS Level 1 Compliant)
# ==============================================================================
# Get your Key ID and Key Secret from: https://dashboard.razorpay.com/app/keys
# For sandbox testing, use Test Mode keys (e.g., rzp_test_...).
# For live transactions, switch to Live Mode keys (e.g., rzp_live_...).

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# OFFICIAL NOTIFICATION & SMTP SETTINGS (Optional)
# ==============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
